[Unit]
Description=Camera glasses Drive sync
After=network-online.target

[Service]
WorkingDirectory=%h/ai-glasses-detector
EnvironmentFile=%h/.config/ai-glasses/runtime.env
ExecStart=%h/ai-glasses-detector/ops/run utils.sync_drive --watch --interval 180
Restart=on-failure
UMask=0077

[Install]
WantedBy=default.target
