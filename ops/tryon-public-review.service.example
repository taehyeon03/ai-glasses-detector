[Unit]
Description=Camera glasses review
After=network-online.target

[Service]
WorkingDirectory=%h/ai-glasses-detector
EnvironmentFile=%h/.config/ai-glasses/runtime.env
ExecStart=%h/ai-glasses-detector/ops/run review.public_review_server
Restart=on-failure
UMask=0077

[Install]
WantedBy=default.target
