# Copy into a local environment file and set paths for your installation.
# Source this file with set -a for interactive use.
TRYON_ROOT=./data
TRYON_YOLO_RUN_ROOT=./data/work/yolo
TRYON_FACE_CROP_PYTHON=python3
TRYON_WANDB_PROJECT=camera-glasses-yolo
REVIEW_PUBLIC_ORIGIN=http://127.0.0.1:8790
REVIEW_PORT=8790
TRYON_REVIEWERS="검수자 1,검수자 2"
TRYON_PRIORITY_REVIEWER="검수자 1"
# Optional overrides for the locally installed Qwen loader and weights:
# TRYON_QWEN_LOADER=/path/to/qwen_image/app.py
# TRYON_QWEN_SNAPSHOTS=/path/to/model/snapshots
